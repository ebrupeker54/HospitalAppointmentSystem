@model HospitalAppointmentSystem.Web.ViewModels.SecretaryBookViewModel
@{
    ViewData["Title"] = "Telefonla Randevu";
}

<div class="page-header">
    <div>
        <h1>Telefonla Randevu</h1>
        <p>Hastayı T.C. kimlik numarasıyla bulun ve onun adına randevu oluşturun.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-brand"><i class="bi bi-arrow-left me-1"></i> Geri</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="panel-card h-100">
            <div class="panel-card-header"><i class="bi bi-search"></i> 1. Hastayı Bul</div>
            <form method="get" asp-action="Book" class="d-flex gap-2 p-3 border-bottom">
                <input name="nationalId" value="@Model.NationalId" class="form-control"
                       placeholder="T.C. Kimlik No" maxlength="11" required />
                <button type="submit" class="btn btn-brand">Ara</button>
            </form>
            <div class="p-3">
                @if (Model.PatientNotFound)
                {
                    <div class="alert alert-warning mb-0">Bu T.C. kimlik numarasıyla kayıtlı hasta bulunamadı.</div>
                }
                else if (Model.Patient != null)
                {
                    <div class="d-flex align-items-center gap-3">
                        <span class="avatar">@Model.Patient.FirstName[0]@Model.Patient.LastName[0]</span>
                        <div>
                            <div class="cell-main">@Model.Patient.FullName</div>
                            <small class="text-muted">
                                <i class="bi bi-telephone me-1"></i>@Model.Patient.PhoneNumber &middot;
                                @Model.Patient.DateOfBirth.ToString("dd.MM.yyyy")
                            </small>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Arayan hastanın T.C. kimlik numarasını girin.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="panel-card h-100">
            <div class="panel-card-header"><i class="bi bi-funnel"></i> 2. Randevu Bilgileri</div>
            <form method="get" asp-action="Book" class="row g-3 p-3">
                <input type="hidden" name="nationalId" value="@Model.NationalId" />
                <div class="col-md-4">
                    <label class="form-label small">Doktor</label>
                    <select name="doctorId" class="form-select" onchange="this.form.submit()" disabled="@(Model.Patient == null)">
                        <option value="">Doktor seçin</option>
                        @foreach (var d in Model.Doctors)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.DoctorId)">@d.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Hizmet</label>
                    <select name="serviceId" class="form-select" onchange="this.form.submit()" disabled="@(Model.DoctorId == null)">
                        <option value="">Hizmet seçin</option>
                        @foreach (var s in Model.Services)
                        {
                            <option value="@s.Id" selected="@(s.Id == Model.ServiceId)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Tarih</label>
                    <input type="date" name="date" class="form-control"
                           value="@Model.Date?.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           onchange="this.form.submit()"
                           disabled="@(Model.ServiceId == null)" />
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Patient != null && Model.SelectedDoctor != null && Model.SelectedService != null && Model.Date != null)
{
    <div class="panel-card">
        <div class="panel-card-header">
            <i class="bi bi-clock"></i> 3. Saat Seçin &middot; @Model.Date.Value.ToString("dd MMMM yyyy, dddd")
        </div>
        @if (!Model.AvailableTimes.Any())
        {
            <div class="empty-state">
                <i class="bi bi-calendar-x"></i>
                <p class="mb-0">Bu tarihte uygun saat bulunmuyor. Lütfen başka bir tarih seçin.</p>
            </div>
        }
        else
        {
            <div class="time-grid p-4">
                @foreach (var t in Model.AvailableTimes)
                {
                    <form asp-action="Book" method="post"
                          onsubmit="return confirm('@Model.Patient.FullName için saat @t.ToString("HH:mm") randevusu oluşturulsun mu?');">
                        <input type="hidden" name="patientId" value="@Model.Patient.Id" />
                        <input type="hidden" name="doctorId" value="@Model.SelectedDoctor.Id" />
                        <input type="hidden" name="serviceId" value="@Model.SelectedService.Id" />
                        <input type="hidden" name="startTime" value="@t.ToString("s")" />
                        <input type="hidden" name="nationalId" value="@Model.NationalId" />
                        <button type="submit" class="time-slot">@t.ToString("HH:mm")</button>
                    </form>
                }
            </div>
        }
    </div>
}