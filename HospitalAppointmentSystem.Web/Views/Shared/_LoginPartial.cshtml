@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var name = User.Identity?.Name ?? string.Empty;
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}

@if (User.Identity?.IsAuthenticated == true)
{
    <ul class="navbar-nav align-items-md-center gap-2 mt-3 mt-md-0">
        <li class="nav-item">
            <a class="btn btn-brand btn-sm px-3" asp-controller="@role" asp-action="Index">
                <i class="bi bi-grid-1x2-fill me-1"></i> My Panel
            </a>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar">@initials</span>
                <span class="d-none d-lg-inline text-start lh-sm">
                    <span class="d-block user-name">@name</span>
                    <small class="text-muted">@role</small>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li><span class="dropdown-item-text small text-muted">@User.FindFirst(ClaimTypes.Email)?.Value</span></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a class="btn btn-outline-brand btn-sm px-3" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-brand btn-sm px-3" asp-controller="Account" asp-action="Register">Register</a>
    </div>
}