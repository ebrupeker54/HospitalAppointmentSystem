@model HospitalAppointmentSystem.Web.Models.Appointment
@{
    ViewData["Title"] = Model.Result!.Title;
    var result = Model.Result!;
}

<div class="page-header no-print">
    <div>
        <h1>@result.Title</h1>
        <p>@Model.MedicalService?.Name &middot; @Model.StartTime.ToString("dd MMMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-light" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Yazdır
        </button>
        <a asp-action="Index" class="btn btn-outline-brand"><i class="bi bi-arrow-left me-1"></i> Geri</a>
    </div>
</div>

<div class="panel-card result-card">
    <div class="p-4 border-bottom d-flex flex-wrap justify-content-between gap-3">
        <div>
            <div class="brand-logo mb-2">
                <span class="logo-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>Medi<span class="text-brand">Point</span></span>
            </div>
            <div class="text-muted small">@Model.Professional?.Branch?.Name</div>
        </div>
        <div class="text-md-end">
            <h2 class="h4 mb-1">@result.Title</h2>
            <div class="text-muted small">Rapor tarihi: @result.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
        </div>
    </div>

    <div class="px-4 py-3 border-bottom">
        <div class="summary-row"><span>Hasta</span><span>@User.Identity?.Name</span></div>
        <div class="summary-row"><span>Hizmet</span><span>@Model.MedicalService?.Name</span></div>
        <div class="summary-row"><span>İşlem tarihi</span><span>@Model.StartTime.ToString("dd MMMM yyyy HH:mm")</span></div>
        <div class="summary-row"><span>Raporlayan</span><span>@result.Author?.DisplayName</span></div>
    </div>

    <div class="p-4">
        <h3 class="h6 text-muted text-uppercase mb-3">Bulgular</h3>
        <div class="result-findings">@result.Findings</div>
    </div>
</div>