@model HospitalAppointmentSystem.Web.ViewModels.BookAppointmentViewModel
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "Randevu Al";
}

<div class="page-header">
    <div>
        <h1>Randevu Al</h1>
        <p>Şube, hizmet ve sağlık personeli seçin, ardından size uygun bir saat belirleyin.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-brand"><i class="bi bi-arrow-left me-1"></i> Geri</a>
</div>

<div class="panel-card mb-4">
    <div class="panel-card-header"><i class="bi bi-funnel"></i> Randevu Bilgileri</div>
    <div class="p-4">
        <form method="get" asp-action="Book" class="row g-3">
            <div class="col-md-6 col-lg-3">
                <label class="form-label">1. Şube</label>
                <select name="branchId" class="form-select" onchange="this.form.submit()">
                    <option value="">Şube seçin</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(b.Id == Model.BranchId)">@b.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6 col-lg-3">
                <label class="form-label">2. Hizmet</label>
                <select name="serviceId" class="form-select" onchange="this.form.submit()" disabled="@(Model.BranchId == null)">
                    <option value="">Hizmet seçin</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.ServiceId)">@s.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6 col-lg-3">
                <label class="form-label">3. Sağlık Personeli</label>
                <select name="professionalId" class="form-select" onchange="this.form.submit()" disabled="@(Model.ServiceId == null)">
                    <option value="">Personel seçin</option>
                    @foreach (var p in Model.Professionals)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.ProfessionalId)">@p.DisplayName</option>
                    }
                </select>
            </div>

            <div class="col-md-6 col-lg-3">
                <label class="form-label">4. Tarih</label>
                <input type="date" name="date" class="form-control"
                       value="@Model.Date?.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()"
                       disabled="@(Model.ProfessionalId == null)" />
            </div>
        </form>
    </div>
</div>

@if (Model.SelectedProfessional != null && Model.SelectedService != null && Model.Date != null)
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-card-header">
                    <i class="bi bi-clock"></i> Uygun Saatler &middot; @Model.Date.Value.ToString("dd MMMM yyyy, dddd")
                </div>
                @if (!Model.AvailableTimes.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-calendar-x"></i>
                        <p class="mb-0">Bu tarihte uygun saat bulunmuyor. Lütfen başka bir tarih seçin.</p>
                    </div>
                }
                else
                {
                    <div class="time-grid p-4">
                        @foreach (var t in Model.AvailableTimes)
                        {
                            <form asp-action="Book" method="post"
                                  onsubmit="return confirm('Saat @t.ToString("HH:mm") için randevu talebi oluşturulsun mu?');">
                                <input type="hidden" name="professionalId" value="@Model.SelectedProfessional.Id" />
                                <input type="hidden" name="serviceId" value="@Model.SelectedService.Id" />
                                <input type="hidden" name="startTime" value="@t.ToString("s")" />
                                <button type="submit" class="time-slot">@t.ToString("HH:mm")</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel-card">
                <div class="panel-card-header"><i class="bi bi-receipt"></i> Özet</div>
                <div class="px-4 py-2">
                    <div class="summary-row"><span>Personel</span><span>@Model.SelectedProfessional.DisplayName</span></div>
                    @if (Model.SelectedProfessional is Doctor doctor)
                    {
                        <div class="summary-row"><span>Uzmanlık</span><span>@doctor.Specialty</span></div>
                    }
                    <div class="summary-row"><span>Şube</span><span>@Model.SelectedProfessional.Branch?.Name</span></div>
                    <div class="summary-row"><span>Hizmet</span><span>@Model.SelectedService.Name</span></div>
                    <div class="summary-row"><span>Süre</span><span>@Model.SelectedService.Duration.TotalMinutes dk</span></div>
                    <div class="summary-row"><span>Ücret</span><span>@Model.SelectedService.Price.ToString("N2") TL</span></div>
                </div>
            </div>
        </div>
    </div>
}