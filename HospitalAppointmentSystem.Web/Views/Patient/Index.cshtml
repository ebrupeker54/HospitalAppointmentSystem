@model List<HospitalAppointmentSystem.Web.Models.Appointment>
@using HospitalAppointmentSystem.Web.Helpers
@{
    ViewData["Title"] = "My Appointments";
}

<h2>My Appointments</h2>
<p class="text-muted">Welcome, @User.Identity?.Name</p>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no appointments yet. Online booking is coming soon.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Doctor</th>
                <th>Branch</th>
                <th>Service</th>
                <th>Duration</th>
                <th>Price</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.Doctor?.FullName</td>
                    <td>@a.Doctor?.Branch?.Name</td>
                    <td>@a.MedicalService?.Name</td>
                    <td>@a.Duration.TotalMinutes min</td>
                    <td>@a.Price.ToString("N2") TL</td>
                    <td><span class="badge @a.Status.ToBadgeClass()">@a.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}