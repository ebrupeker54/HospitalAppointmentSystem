@model List<HospitalAppointmentSystem.Web.Models.Appointment>
@using HospitalAppointmentSystem.Web.Helpers
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "My Appointments";
    var upcoming = Model.Count(a => a.IsActive && a.StartTime > DateTime.Now);
    var pending = Model.Count(a => a.Status == AppointmentStatus.Pending);
    var completed = Model.Count(a => a.Status == AppointmentStatus.Completed);
}

<div class="page-header">
    <div>
        <h1>My Appointments</h1>
        <p>Welcome back, @User.Identity?.Name</p>
    </div>
    <a asp-action="Book" class="btn btn-brand">
        <i class="bi bi-plus-lg me-1"></i> Book Appointment
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-calendar-event"></i></div>
            <div><div class="stat-value">@upcoming</div><div class="stat-label">Upcoming</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-amber">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="stat-value">@pending</div><div class="stat-label">Waiting for Approval</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
            <div><div class="stat-value">@completed</div><div class="stat-label">Completed</div></div>
        </div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-card-header"><i class="bi bi-list-ul"></i> Appointment History</div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <p class="mb-0">You have no appointments yet.</p>
            <a asp-action="Book" class="btn btn-brand mt-3">Book your first appointment</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr><th>Date</th><th>Doctor</th><th>Service</th><th>Price</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@a.StartTime.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">@a.StartTime.ToString("HH:mm") - @a.EndTime.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="cell-main">Dr. @a.Doctor?.FullName</div>
                                <small class="text-muted">@a.Doctor?.Branch?.Name</small>
                            </td>
                            <td>
                                <div>@a.MedicalService?.Name</div>
                                <small class="text-muted">@a.Duration.TotalMinutes min</small>
                            </td>
                            <td>@a.Price.ToString("N2") TL</td>
                            <td>
                                <span class="badge @a.Status.ToBadgeClass()">@a.Status</span>
                                @if (a.Status == AppointmentStatus.Rejected && !string.IsNullOrEmpty(a.RejectionReason))
                                {
                                    <div class="small text-muted mt-1">@a.RejectionReason</div>
                                }
                            </td>
                            <td class="text-end">
                                @if (a.IsActive && a.StartTime > DateTime.Now)
                                {
                                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-lg me-1"></i>Cancel
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>