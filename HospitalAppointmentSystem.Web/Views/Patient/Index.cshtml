@model List<HospitalAppointmentSystem.Web.Models.Appointment>
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "Randevularım";
    var upcoming = Model.Count(a => a.IsActive && a.StartTime > DateTime.Now);
    var pending = Model.Count(a => a.CurrentStatus == AppointmentStatus.Pending);
    var completed = Model.Count(a => a.CurrentStatus == AppointmentStatus.Completed);
}

<div class="page-header">
    <div>
        <h1>Randevularım</h1>
        <p>Tekrar hoş geldiniz, @User.Identity?.Name</p>
    </div>
    <a asp-action="Book" class="btn btn-brand">
        <i class="bi bi-plus-lg me-1"></i> Randevu Al
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-calendar-event"></i></div>
            <div><div class="stat-value">@upcoming</div><div class="stat-label">Yaklaşan</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-amber">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="stat-value">@pending</div><div class="stat-label">Onay Bekleyen</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
            <div><div class="stat-value">@completed</div><div class="stat-label">Tamamlanan</div></div>
        </div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-card-header"><i class="bi bi-list-ul"></i> Randevu Geçmişi</div>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <p class="mb-0">Henüz bir randevunuz yok.</p>
            <a asp-action="Book" class="btn btn-brand mt-3">İlk randevunuzu alın</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern align-middle">
                <thead>
                    <tr><th>Tarih</th><th>Doktor</th><th>Hizmet</th><th>Ücret</th><th>Durum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@a.StartTime.ToString("dd MMM yyyy")</div>
                                <small class="text-muted">@a.StartTime.ToString("HH:mm") - @a.EndTime.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="cell-main">@a.Professional?.DisplayName</div>
                                <small class="text-muted">@a.Professional?.Branch?.Name</small>
                            </td>
                            <td>
                                <div>@a.MedicalService?.Name</div>
                                <small class="text-muted">@a.Duration.TotalMinutes dk</small>
                            </td>
                            <td>@a.Price.ToString("N2") TL</td>
                            <td>
                                <span class="badge @a.CurrentStatus.ToBadgeClass()">@a.CurrentStatus.ToDisplay()</span>
                                @if (a.Payment != null)
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-light border @(a.Payment.Status == PaymentStatus.Paid ? "text-success" : "text-muted")">
                                            <i class="bi bi-credit-card me-1"></i>@a.Payment.Status.ToDisplay()
                                        </span>
                                    </div>
                                }
                                @if (a.Status == AppointmentStatus.Rejected && !string.IsNullOrEmpty(a.RejectionReason))
                                {
                                    <div class="small text-muted mt-1">@a.RejectionReason</div>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-2 justify-content-end">
                                    @if (a.CanBePaid)
                                    {
                                        <button type="button" class="btn btn-sm btn-brand"
                                                data-bs-toggle="modal" data-bs-target="#paymentModal"
                                                data-id="@a.Id"
                                                data-amount="@a.Price.ToString("N2") TL"
                                                data-service="@a.MedicalService?.Name · @a.StartTime.ToString("dd MMMM yyyy HH:mm")">
                                            <i class="bi bi-credit-card me-1"></i>Ödeme Yap
                                        </button>
                                    }
                                    @if (a.Result != null)
                                    {
                                        <a asp-action="Result" asp-route-id="@a.Id" class="btn btn-sm btn-outline-brand">
                                            <i class="bi bi-file-earmark-medical me-1"></i>Sonuç
                                        </a>
                                    }
                                    @if (a.IsActive && a.StartTime > DateTime.Now)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@a.Id" method="post"
                                              onsubmit="return confirm('Bu randevuyu iptal etmek istediğinizden emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-lg me-1"></i>İptal Et
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel"><i class="bi bi-credit-card me-2"></i>Ödeme Yap</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-flex gap-2 align-items-center small mb-4">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>Bu bir demo ödemedir; kartınızdan ücret çekilmez ve kart bilgileriniz sunucuya gönderilmez.</span>
                </div>
                <div class="row g-4 align-items-center">
                    <div class="col-md-6">
                        <div class="credit-card" id="creditCard">
                            <div class="card-inner">
                                <div class="card-face card-front">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="card-chip"></div>
                                        <span class="card-brand" id="cardBrand"></span>
                                    </div>
                                    <div class="card-number-display" id="cardNumberDisplay">•••• •••• •••• ••••</div>
                                    <div class="d-flex justify-content-between align-items-end gap-3">
                                        <div class="text-truncate">
                                            <div class="card-label">KART SAHİBİ</div>
                                            <div class="card-value" id="cardNameDisplay">AD SOYAD</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="card-label">SON KUL.</div>
                                            <div class="card-value" id="cardExpiryDisplay">AA/YY</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-face card-back">
                                    <div class="card-stripe"></div>
                                    <div class="card-signature"><span id="cardCvvDisplay">•••</span></div>
                                    <div class="card-label card-cvv-label">CVV</div>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <div class="text-muted small" id="paymentService"></div>
                            <div class="fs-4 fw-bold" id="paymentAmount"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <form asp-action="Pay" method="post" id="paymentForm" novalidate>
                            <input type="hidden" name="id" id="paymentAppointmentId" />
                            <div class="mb-3">
                                <label class="form-label" for="cardName">Kart Üzerindeki İsim</label>
                                <input id="cardName" class="form-control" autocomplete="off" maxlength="26" placeholder="Ad Soyad" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="cardNumber">Kart Numarası</label>
                                <input id="cardNumber" class="form-control" inputmode="numeric" autocomplete="off" placeholder="0000 0000 0000 0000" />
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col">
                                    <label class="form-label" for="cardExpiry">Son Kullanma</label>
                                    <input id="cardExpiry" class="form-control" inputmode="numeric" autocomplete="off" placeholder="AA/YY" maxlength="5" />
                                </div>
                                <div class="col">
                                    <label class="form-label" for="cardCvv">CVV</label>
                                    <input id="cardCvv" class="form-control" inputmode="numeric" autocomplete="off" placeholder="000" maxlength="3" />
                                </div>
                            </div>
                            <div class="text-danger small mb-3 d-none" id="paymentError"></div>
                            <button type="submit" class="btn btn-brand w-100 py-2" id="paymentSubmit">
                                <i class="bi bi-lock-fill me-1"></i>Ödemeyi Tamamla
                            </button>
                            <p class="small text-muted text-center mt-2 mb-0">Test kartı: 4242 4242 4242 4242</p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const el = id => document.getElementById(id);
            const modal = el('paymentModal');
            const card = el('creditCard'), number = el('cardNumber'), name = el('cardName'),
                expiry = el('cardExpiry'), cvv = el('cardCvv'), error = el('paymentError'), submit = el('paymentSubmit');
            const submitText = submit.innerHTML;

            function brandOf(digits) {
                if (/^4/.test(digits)) return 'VISA';
                if (/^(5[1-5]|2[2-7])/.test(digits)) return 'Mastercard';
                if (/^9792/.test(digits)) return 'TROY';
                return '';
            }

            function passesLuhn(digits) {
                let sum = 0;
                for (let i = 0; i < digits.length; i++) {
                    let d = parseInt(digits[digits.length - 1 - i], 10);
                    if (i % 2 === 1) { d *= 2; if (d > 9) d -= 9; }
                    sum += d;
                }
                return sum % 10 === 0;
            }

            number.addEventListener('input', function () {
                const digits = number.value.replace(/\D/g, '').slice(0, 16);
                number.value = digits.replace(/(.{4})/g, '$1 ').trim();
                const padded = digits + '•'.repeat(16 - digits.length);
                el('cardNumberDisplay').textContent = padded.replace(/(.{4})/g, '$1 ').trim();
                el('cardBrand').textContent = brandOf(digits);
            });

            name.addEventListener('input', function () {
                el('cardNameDisplay').textContent = name.value.trim() ? name.value.toLocaleUpperCase('tr-TR') : 'AD SOYAD';
            });

            expiry.addEventListener('input', function () {
                const digits = expiry.value.replace(/\D/g, '').slice(0, 4);
                expiry.value = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;
                el('cardExpiryDisplay').textContent = expiry.value || 'AA/YY';
            });

            cvv.addEventListener('input', function () {
                cvv.value = cvv.value.replace(/\D/g, '').slice(0, 3);
                el('cardCvvDisplay').textContent = cvv.value ? '•'.repeat(cvv.value.length) : '•••';
            });
            cvv.addEventListener('focus', () => card.classList.add('flipped'));
            cvv.addEventListener('blur', () => card.classList.remove('flipped'));

            modal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                el('paymentAppointmentId').value = button.dataset.id;
                el('paymentAmount').textContent = button.dataset.amount;
                el('paymentService').textContent = button.dataset.service;
                [name, number, expiry, cvv].forEach(input => { input.value = ''; input.dispatchEvent(new Event('input')); });
                error.classList.add('d-none');
                submit.disabled = false;
                submit.innerHTML = submitText;
                card.classList.remove('flipped');
            });

            el('paymentForm').addEventListener('submit', function (event) {
                event.preventDefault();
                const digits = number.value.replace(/\D/g, '');
                const parts = expiry.value.split('/');
                const month = parseInt(parts[0], 10), year = 2000 + parseInt(parts[1], 10);
                const now = new Date();
                const expired = year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth() + 1);

                let message = '';
                if (!name.value.trim()) message = 'Kart üzerindeki ismi giriniz.';
                else if (digits.length !== 16 || !passesLuhn(digits)) message = 'Geçerli bir kart numarası giriniz.';
                else if (parts.length !== 2 || !(month >= 1 && month <= 12) || isNaN(year) || expired) message = 'Geçerli bir son kullanma tarihi giriniz.';
                else if (cvv.value.length !== 3) message = 'CVV 3 haneli olmalıdır.';

                if (message) {
                    error.textContent = message;
                    error.classList.remove('d-none');
                    return;
                }

                error.classList.add('d-none');
                submit.disabled = true;
                submit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>İşleniyor...';
                [name, number, expiry, cvv].forEach(input => input.value = '');
                setTimeout(() => event.target.submit(), 1200);
            });
        })();
    </script>
}