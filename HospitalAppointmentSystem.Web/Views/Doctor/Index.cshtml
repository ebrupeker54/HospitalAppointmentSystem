@model HospitalAppointmentSystem.Web.ViewModels.DoctorDashboardViewModel
@using HospitalAppointmentSystem.Web.Helpers
@{
    ViewData["Title"] = "Doctor Panel";
}

<h2>Doctor Panel</h2>
<p class="text-muted">Welcome, @User.Identity?.Name</p>

<div class="row">
    <div class="col-lg-8 mb-4">
        <h4>Appointments</h4>
        @if (!Model.Appointments.Any())
        {
            <div class="alert alert-info">No appointments yet.</div>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Date</th><th>Patient</th><th>Service</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td>@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@a.Patient?.FullName</td>
                            <td>@a.MedicalService?.Name</td>
                            <td><span class="badge @a.Status.ToBadgeClass()">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-4">
        <h4>Upcoming Availability</h4>
        <ul class="list-group">
            @foreach (var s in Model.UpcomingSlots)
            {
                <li class="list-group-item">
                    @s.Start.ToString("dd.MM.yyyy ddd") &middot; @s.Start.ToString("HH:mm") - @s.End.ToString("HH:mm")
                </li>
            }
        </ul>
    </div>
</div>