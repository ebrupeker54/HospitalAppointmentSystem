@{
    ViewData["Title"] = "Welcome";
}

<section class="hero mb-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="hero-tag"><i class="bi bi-shield-check me-1"></i> Healthcare, simplified</span>
            <h1 class="mt-3">Book your hospital appointment in minutes</h1>
            <p class="lead mt-3 mb-4">
                Choose your branch, service and doctor, pick an available time and get confirmed, all online.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg hero-btn">
                    <i class="bi bi-person-plus me-2"></i>Create Account
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Login</a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <i class="bi bi-hospital hero-illustration"></i>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-calendar2-check"></i></div>
            <h5>Online Booking</h5>
            <p>Book appointments any time, from anywhere, without waiting on the phone.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-buildings"></i></div>
            <h5>Multi-Branch</h5>
            <p>One account for every branch of the institution, with their own hours and departments.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-clock-history"></i></div>
            <h5>No Conflicts</h5>
            <p>Smart scheduling checks working hours and availability so time slots never overlap.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-patch-check"></i></div>
            <h5>Doctor Approval</h5>
            <p>Every request is reviewed by the doctor, and you can follow its status in real time.</p>
        </div>
    </div>
</div>