@model List<HospitalAppointmentSystem.Web.Models.Institution>
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "Kurumlar ve Şubeler";
}

<partial name="_AdminNav" />

<div class="page-header">
    <div>
        <h1>Kurumlar ve Şubeler</h1>
        <p>Hastaneleri, klinikleri ve şubelerini yönetin.</p>
    </div>
    <button class="btn btn-brand" type="button" data-bs-toggle="collapse" data-bs-target="#newInstitution">
        <i class="bi bi-plus-lg me-1"></i> Yeni Kurum
    </button>
</div>

<div class="collapse mb-4" id="newInstitution">
    <div class="panel-card">
        <div class="panel-card-header"><i class="bi bi-hospital"></i> Yeni Kurum</div>
        <form asp-action="CreateInstitution" method="post" class="row g-3 p-4">
            <div class="col-md-6">
                <label class="form-label">Kurum Adı</label>
                <input name="name" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Tür</label>
                <select name="type" class="form-select">
                    @foreach (var t in Enum.GetValues<InstitutionType>())
                    {
                            <option value="@t">@t.ToDisplay()</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-brand w-100">Oluştur</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
        <div class="panel-card">
            <div class="empty-state">
                <i class="bi bi-hospital"></i>
                <p class="mb-0">Henüz kurum yok. İlk kurumu oluşturun.</p>
            </div>
        </div>
}

@foreach (var institution in Model)
{
        <div class="panel-card mb-4">
            <div class="panel-card-header">
                <i class="bi bi-hospital"></i>
                <span>@institution.Name</span>
                <span class="badge service-badge">@institution.Type.ToDisplay()</span>
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@institution.Id">
                        <i class="bi bi-pencil me-1"></i>Düzenle
                    </button>
                    <button class="btn btn-sm btn-outline-brand" type="button" data-bs-toggle="collapse" data-bs-target="#branch-@institution.Id">
                        <i class="bi bi-plus-lg me-1"></i>Şube Ekle
                    </button>
                </div>
            </div>

            <div class="collapse" id="edit-@institution.Id">
                <form asp-action="UpdateInstitution" asp-route-id="@institution.Id" method="post" class="row g-3 p-3 border-bottom bg-light">
                    <div class="col-md-6">
                        <label class="form-label small">Kurum Adı</label>
                        <input name="name" value="@institution.Name" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Tür</label>
                        <select name="type" class="form-select">
                        @foreach (var t in Enum.GetValues<InstitutionType>())
                        {
                                    <option value="@t" selected="@(t == institution.Type)">@t.ToDisplay()</option>
                        }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-brand w-100">Kaydet</button>
                    </div>
                </form>
            </div>

            <div class="collapse" id="branch-@institution.Id">
                <form asp-action="CreateBranch" method="post" class="row g-3 p-3 border-bottom bg-light">
                    <input type="hidden" name="institutionId" value="@institution.Id" />
                    <div class="col-md-3">
                        <label class="form-label small">Şube Adı</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Adres</label>
                        <input name="address" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Telefon</label>
                        <input name="phoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-brand w-100">Ekle</button>
                    </div>
                </form>
            </div>

        @if (!institution.Branches.Any())
        {
                    <div class="empty-state"><p class="mb-0">Bu kurumun henüz şubesi yok.</p></div>
        }
        else
        {
                    <div class="table-responsive">
                        <table class="table table-modern align-middle">
                            <thead>
                                <tr><th>Şube</th><th>Adres</th><th>Telefon</th><th></th></tr>
                            </thead>
                            <tbody>
                        @foreach (var b in institution.Branches.OrderBy(b => b.Name))
                        {
                                        <tr>
                                            <td class="cell-main">@b.Name</td>
                                            <td>@b.Address</td>
                                            <td>@b.PhoneNumber</td>
                                            <td class="text-end">
                                                <a asp-action="Branch" asp-route-id="@b.Id" class="btn btn-sm btn-outline-brand">
                                                    <i class="bi bi-gear me-1"></i>Yönet
                                                </a>
                                            </td>
                                        </tr>
                        }
                            </tbody>
                        </table>
                    </div>
        }
        </div>
}