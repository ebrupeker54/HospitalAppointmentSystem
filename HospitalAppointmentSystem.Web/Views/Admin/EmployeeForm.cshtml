@model HospitalAppointmentSystem.Web.ViewModels.StaffFormViewModel
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = Model.IsEdit ? "Personeli Düzenle" : "Yeni Personel";
}

<partial name="_AdminNav" />

<div class="page-header">
    <div>
        <h1>@(Model.IsEdit ? "Personeli Düzenle" : "Yeni Personel")</h1>
        <p>@(Model.IsEdit ? "Personelin bilgilerini ve görevlerini güncelleyin." : "Personel türünü seçin, bilgilerini girin ve görevlendirin.")</p>
    </div>
    <a asp-action="Employees" class="btn btn-outline-brand"><i class="bi bi-arrow-left me-1"></i> Geri</a>
</div>

<form asp-action="@(Model.IsEdit ? "EditEmployee" : "CreateEmployee")" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="panel-card">
                <div class="panel-card-header"><i class="bi bi-person"></i> Kişisel Bilgiler</div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Type" class="form-label"></label>
                            @if (Model.IsEdit)
                            {
                                <input type="hidden" asp-for="Type" />
                                <input class="form-control" value="@Model.Type.ToDisplay()" disabled />
                                <small class="text-muted">Personel türü sonradan değiştirilemez.</small>
                            }
                            else
                            {
                                <select asp-for="Type" class="form-select">
                                    @foreach (var t in Enum.GetValues<StaffType>())
                                    {
                                        <option value="@t">@t.ToDisplay()</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6" id="specialtyGroup">
                            <label asp-for="Specialty" class="form-label"></label>
                            <input asp-for="Specialty" class="form-control" placeholder="Örn. Kardiyoloji" />
                        </div>
                        @if (!Model.IsEdit)
                        {
                            <div class="col-12">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel-card">
                <div class="panel-card-header"><i class="bi bi-diagram-3"></i> Görevlendirme</div>
                <div class="p-4">
                    <div class="mb-3">
                        <label asp-for="BranchId" class="form-label"></label>
                        <select asp-for="BranchId" class="form-select">
                            <option value="">Şube seçin</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" data-institution="@b.InstitutionId">@b.Institution?.Name &middot; @b.Name</option>
                            }
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId" class="form-select">
                            <option value="">Bölüm yok</option>
                            @foreach (var b in Model.Branches)
                            {
                                foreach (var d in b.Departments.OrderBy(d => d.Name))
                                {
                                    <option value="@d.Id" data-branch="@b.Id">@d.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div id="servicesGroup">
                        <label class="form-label">Verdiği Hizmetler</label>
                        <p class="small text-muted mb-2 branch-hint">Hizmetleri görmek için önce bir şube seçin.</p>
                        @foreach (var s in Model.Services)
                        {
                            <div class="form-check service-option" data-institution="@s.InstitutionId">
                                <input class="form-check-input" type="checkbox" name="ServiceIds" value="@s.Id"
                                       id="svc-@s.Id" checked="@Model.ServiceIds.Contains(s.Id)" />
                                <label class="form-check-label" for="svc-@s.Id">
                                    @s.Name <small class="text-muted">(@s.Category.ToDisplay())</small>
                                </label>
                            </div>
                        }
                    </div>

                    <div id="doctorsGroup">
                        <label class="form-label">Bağlı Olduğu Doktorlar</label>
                        <p class="small text-muted mb-2 branch-hint">Doktorları görmek için önce bir şube seçin.</p>
                        @foreach (var d in Model.Doctors)
                        {
                            <div class="form-check doctor-option" data-branch="@d.BranchId">
                                <input class="form-check-input" type="checkbox" name="DoctorIds" value="@d.Id"
                                       id="doc-@d.Id" checked="@Model.DoctorIds.Contains(d.Id)" />
                                <label class="form-check-label" for="doc-@d.Id">@d.DisplayName <small class="text-muted">(@d.Specialty)</small></label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-brand px-4">
            <i class="bi bi-save me-1"></i>@(Model.IsEdit ? "Değişiklikleri Kaydet" : "Personeli Oluştur")
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const type = document.getElementById('Type');
            const branch = document.getElementById('BranchId');
            const department = document.getElementById('DepartmentId');

            function refresh() {
                const selectedType = type.value;
                const isSecretary = selectedType === 'Secretary';
                document.getElementById('specialtyGroup').classList.toggle('d-none', selectedType !== 'Doctor');
                document.getElementById('servicesGroup').classList.toggle('d-none', isSecretary);
                document.getElementById('doctorsGroup').classList.toggle('d-none', !isSecretary);

                const selectedBranch = branch.options[branch.selectedIndex];
                const branchId = branch.value;
                const institutionId = selectedBranch ? selectedBranch.dataset.institution : undefined;

                department.querySelectorAll('option[data-branch]').forEach(function (option) {
                    const visible = option.dataset.branch === branchId;
                    option.hidden = !visible;
                    if (!visible && option.selected) department.value = '';
                });

                document.querySelectorAll('.service-option').forEach(function (item) {
                    const visible = !isSecretary && item.dataset.institution === institutionId;
                    item.classList.toggle('d-none', !visible);
                    if (!visible) item.querySelector('input').checked = false;
                });

                document.querySelectorAll('.doctor-option').forEach(function (item) {
                    const visible = isSecretary && item.dataset.branch === branchId;
                    item.classList.toggle('d-none', !visible);
                    if (!visible) item.querySelector('input').checked = false;
                });

                document.querySelectorAll('.branch-hint').forEach(function (hint) {
                    hint.classList.toggle('d-none', !!branchId);
                });
            }

            type.addEventListener('change', refresh);
            branch.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}