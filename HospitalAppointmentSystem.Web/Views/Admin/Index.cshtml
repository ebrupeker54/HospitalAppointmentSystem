@model HospitalAppointmentSystem.Web.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="page-header">
    <div>
        <h1>Admin Panel</h1>
        <p>Welcome, @User.Identity?.Name</p>
    </div>
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-hospital"></i></div>
            <div><div class="stat-value">@Model.InstitutionCount</div><div class="stat-label">Institutions</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-buildings"></i></div>
            <div><div class="stat-value">@Model.BranchCount</div><div class="stat-label">Branches</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-violet">
            <div class="stat-icon"><i class="bi bi-person-badge"></i></div>
            <div><div class="stat-value">@Model.DoctorCount</div><div class="stat-label">Doctors</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-rose">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div><div class="stat-value">@Model.PatientCount</div><div class="stat-label">Patients</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-amber">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="stat-value">@Model.PendingAppointmentCount</div><div class="stat-label">Pending</div></div>
        </div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-card-header"><i class="bi bi-person-badge"></i> Doctors</div>
    <div class="table-responsive">
        <table class="table table-modern align-middle">
            <thead>
                <tr><th>Doctor</th><th>Specialty</th><th>Branch</th><th>Services</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Doctors)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@(d.FirstName.Length > 0 ? d.FirstName[0] : ' ')@(d.LastName.Length > 0 ? d.LastName[0] : ' ')</span>
                                <div>
                                    <div class="cell-main">@d.FullName</div>
                                    <small class="text-muted">@d.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>@d.Specialty</td>
                        <td>@d.Branch?.Name</td>
                        <td>
                            @foreach (var s in d.Services)
                            {
                                <span class="badge service-badge">@s.Name</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>