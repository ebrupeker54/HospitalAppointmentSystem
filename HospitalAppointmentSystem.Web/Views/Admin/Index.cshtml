@model HospitalAppointmentSystem.Web.ViewModels.AdminDashboardViewModel
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<partial name="_AdminNav" />

<div class="page-header">
    <div>
        <h1>Yönetim Paneli</h1>
        <p>Hoş geldiniz, @User.Identity?.Name</p>
    </div>
</div>

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
    <div class="col">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-hospital"></i></div>
            <div><div class="stat-value">@Model.InstitutionCount</div><div class="stat-label">Kurum</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="bi bi-buildings"></i></div>
            <div><div class="stat-value">@Model.BranchCount</div><div class="stat-label">Şube</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-violet">
            <div class="stat-icon"><i class="bi bi-person-badge"></i></div>
            <div><div class="stat-value">@Model.StaffCount</div><div class="stat-label">Doktor</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-rose">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div><div class="stat-value">@Model.PatientCount</div><div class="stat-label">Hasta</div></div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card stat-amber">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="stat-value">@Model.PendingAppointmentCount</div><div class="stat-label">Onay Bekleyen</div></div>
        </div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-card-header">
        <i class="bi bi-person-badge"></i> Personeller
        <a asp-action="Employees" class="btn btn-sm btn-light ms-auto">Tümünü Yönet</a>
    </div>
    <div class="table-responsive">
        <table class="table table-modern align-middle">
            <thead>
                <tr><th>Personel</th><th>Tür</th><th>Şube</th><th>Görev</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Staff)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@(s.FirstName.Length > 0 ? s.FirstName[0] : ' ')@(s.LastName.Length > 0 ? s.LastName[0] : ' ')</span>
                                <div>
                                    <div class="cell-main">@s.DisplayName</div>
                                    <small class="text-muted">@s.Email</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge service-badge">@StaffFactory.TypeOf(s).ToDisplay()</span></td>
                        <td>@s.Branch?.Name</td>
                        <td>
                            @if (s is HealthcareProfessional p)
                            {
                                @foreach (var service in p.Services)
                                {
                                    <span class="badge service-badge">@service.Name</span>
                                }
                            }
                            else if (s is Secretary sec)
                            {
                                @foreach (var d in sec.Doctors)
                                {
                                    <span class="badge service-badge"><i class="bi bi-person me-1"></i>@d.DisplayName</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>