@model List<HospitalAppointmentSystem.Web.Models.Institution>
@using System.Globalization
@using HospitalAppointmentSystem.Web.Models
@{
    ViewData["Title"] = "Hizmetler";
}

<partial name="_AdminNav" />

<div class="page-header">
    <div>
        <h1>Sağlık Hizmetleri</h1>
        <p>Her kurumun sunduğu hizmetleri, sürelerini ve ücretlerini tanımlayın.</p>
    </div>
</div>

@foreach (var institution in Model)
{
    <div class="panel-card mb-4">
        <div class="panel-card-header">
            <i class="bi bi-hospital"></i>
            <span>@institution.Name</span>
            <button class="btn btn-sm btn-outline-brand ms-auto" type="button"
                    data-bs-toggle="collapse" data-bs-target="#new-service-@institution.Id">
                <i class="bi bi-plus-lg me-1"></i>Hizmet Ekle
            </button>
        </div>

        <div class="collapse" id="new-service-@institution.Id">
            <form asp-action="CreateService" method="post" class="row g-3 p-3 border-bottom bg-light">
                <input type="hidden" name="institutionId" value="@institution.Id" />
                <div class="col-md-4">
                    <label class="form-label small">Hizmet Adı</label>
                    <input name="name" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Kategori</label>
                    <select name="category" class="form-select">
                        @foreach (var c in Enum.GetValues<ServiceCategory>())
                        {
                            <option value="@c">@c.ToDisplay()</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Süre (dk)</label>
                    <input name="durationMinutes" type="number" min="5" step="5" value="20" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Ücret (TL)</label>
                    <input name="price" type="number" min="0" step="0.01" value="0" class="form-control" required />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-brand w-100">Ekle</button>
                </div>
            </form>
        </div>

        @if (!institution.Services.Any())
        {
            <div class="empty-state"><p class="mb-0">Henüz hizmet tanımlanmadı.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle">
                    <thead>
                        <tr><th>Hizmet</th><th>Kategori</th><th>Süre</th><th>Ücret</th><th>Doktor</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in institution.Services.OrderBy(s => s.Name))
                        {
                            <tr>
                                <td class="cell-main">@s.Name</td>
                                <td><span class="badge service-badge">@s.Category.ToDisplay()</span></td>
                                <td>@s.Duration.TotalMinutes dk</td>
                                <td>@s.Price.ToString("N2") TL</td>
                                <td>@s.Professionals.Count</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#edit-service-@s.Id">
                                        <i class="bi bi-pencil me-1"></i>Düzenle
                                    </button>
                                </td>
                            </tr>
                            <tr class="collapse" id="edit-service-@s.Id">
                                <td colspan="6" class="bg-light">
                                    <form asp-action="UpdateService" asp-route-id="@s.Id" method="post" class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small">Hizmet Adı</label>
                                            <input name="name" value="@s.Name" class="form-control" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">Kategori</label>
                                            <select name="category" class="form-select">
                                                @foreach (var c in Enum.GetValues<ServiceCategory>())
                                                {
                                                    <option value="@c" selected="@(c == s.Category)">@c.ToDisplay()</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Süre (dk)</label>
                                            <input name="durationMinutes" type="number" min="5" step="5"
                                                   value="@s.Duration.TotalMinutes" class="form-control" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Ücret (TL)</label>
                                            <input name="price" type="number" min="0" step="0.01"
                                                   value="@s.Price.ToString("0.00", CultureInfo.InvariantCulture)" class="form-control" required />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="submit" class="btn btn-brand w-100">Kaydet</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}